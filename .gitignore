# Local upstream checkouts and research scratch files
.research/
.dsh/

# Local debugging scratch (screenshots, pulled databases) — never part of the app
.scratch/

# 固定版本模型由 tools/fetch_vision_models.py 校验后准备，不提交大二进制。
core/vision/src/main/assets/vision/models/

# 可复现的专用机翻源码由固定版本脚本准备；语言包在运行时按需下载。
core/translation/src/main/cpp/third_party/

# Android / IDE local state
.gradle/
**/build/
**/.cxx/
local.properties
.idea/
*.iml
.kotlin/

# Local credentials and signing material
.env
.env.*
!.env.example
*.jks
*.keystore
signing.properties
keystore.properties

# Python-generated bytecode
__pycache__/
*.py[cod]

# Operating system files
Thumbs.db
.DS_Store

# 由 :core:database 的 syncMigrationSchemas 从 schemas/ 同步而来，供 MigrationTestHelper
# 从 assets 读取导出的 schema；源文件是 schemas/，这里不重复提交。
core/database/src/androidTest/assets/
